<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Номерок | Генератор</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html, body { height:100%; overflow:hidden; }
body {
  background:#000; color:#fff;
  font-family:-apple-system,'Segoe UI',Roboto,sans-serif;
  user-select:none; position:relative;
}
#snow { position:fixed; inset:0; pointer-events:none; z-index:1; overflow:hidden; }
.snowflake { position:absolute; background:#fff; border-radius:50%; opacity:.5; animation:fall linear infinite; }
@keyframes fall {
  0% { transform:translateY(-20px) translateX(0); opacity:0; }
  10% { opacity:.6; }
  90% { opacity:.6; }
  100% { transform:translateY(105vh) translateX(30px); opacity:0; }
}
.top-bar {
  position:fixed; top:0; left:0; right:0; z-index:10;
  display:flex; align-items:center; gap:8px;
  padding:12px 14px;
  background:linear-gradient(180deg,rgba(0,0,0,.95),transparent);
}
.menu-btn {
  width:40px; height:40px; border-radius:12px;
  background:rgba(255,255,255,.06); border:none;
  display:flex; flex-direction:column; justify-content:center; align-items:center;
  gap:4px; cursor:pointer; position:relative; flex-shrink:0;
}
.menu-btn span { width:16px; height:2px; background:#fff; border-radius:2px; }
.lvl-pill {
  height:40px; padding:0 14px; border-radius:12px;
  background:rgba(255,255,255,.06);
  display:flex; align-items:center; gap:8px;
}
.lvl-pill .num { font-size:14px; font-weight:800; }
.lvl-pill .bar { width:44px; height:6px; border-radius:3px; background:rgba(255,255,255,.12); overflow:hidden; }
.lvl-pill .bar > div { height:100%; background:linear-gradient(90deg,#2ecc71,#00ff88); border-radius:3px; width:60%; }
.clover-pill {
  height:40px; padding:0 12px; border-radius:12px;
  background:rgba(255,255,255,.06);
  display:flex; align-items:center; gap:6px;
  font-size:14px; font-weight:800;
}
.balance-box { margin-left:auto; text-align:right; }
.balance-box .lbl { font-size:9px; color:#888; letter-spacing:1px; text-transform:uppercase; }
.balance-box .val { font-size:16px; font-weight:900; color:#ffd700; }
.tabs {
  position:fixed; top:62px; left:0; right:0; z-index:9;
  display:flex; gap:8px; padding:0 14px 10px;
  background:linear-gradient(180deg,#000 60%,transparent);
}
.tab {
  flex:1; padding:10px 8px; border-radius:12px;
  background:rgba(255,255,255,.05); border:none;
  color:#888; font-size:13px; font-weight:800;
  cursor:pointer;
}
.tab.active { background:rgba(255,255,255,.15); color:#fff; }
.tab.gold { background:linear-gradient(135deg,#ffd700,#ff9500); color:#000; flex:0 0 auto; padding:10px 16px; }
.main {
  position:relative; z-index:5; height:100vh;
  display:flex; flex-direction:column;
  padding:130px 14px 90px; overflow-y:auto;
}
.main::-webkit-scrollbar { display:none; }
.rarity-bar {
  display:flex; align-items:center; justify-content:space-between;
  background:rgba(20,20,26,.85); border-radius:14px;
  padding:12px 16px; margin-bottom:12px;
  border:1px solid rgba(255,255,255,.05);
}
.rarity-name { font-size:13px; font-weight:800; letter-spacing:1px; }
.rarity-price { font-size:18px; font-weight:900; }
.rarity-dots { display:flex; gap:4px; margin-top:6px; }
.rarity-dots span { width:10px; height:6px; border-radius:3px; background:rgba(255,255,255,.15); }
.rarity-dots span.on { background:#ffd700; }
.number-card {
  background:linear-gradient(135deg,#1a1a24,#0d0d12);
  border-radius:20px; padding:24px 18px; margin-bottom:14px;
  border:1px solid rgba(255,255,255,.08);
  text-align:center; position:relative; overflow:hidden;
  transition:box-shadow .3s, transform .3s;
}
.number-card.shake { animation:shake .5s; }
@keyframes shake {
  0%,100% { transform:translateX(0); }
  25% { transform:translateX(-8px); }
  50% { transform:translateX(8px); }
  75% { transform:translateX(-5px); }
}
.number-big {
  font-size:26px; font-weight:900; letter-spacing:1px;
  margin:8px 0 10px; word-break:break-word;
}
.number-region { font-size:13px; color:#888; margin-bottom:8px; }
.beauty-list { display:flex; flex-direction:column; gap:4px; font-size:12px; color:#aaa; margin-bottom:12px; }
.beauty-list .item { color:#2ecc71; font-weight:700; }
.beauty-list .mult { color:#ffd700; }
.actions { display:flex; gap:8px; justify-content:center; margin-top:10px; }
.actions button {
  background:rgba(255,255,255,.08); border:none;
  color:#fff; padding:10px 18px; border-radius:12px;
  font-size:13px; font-weight:700; cursor:pointer;
}
.stake-row { display:flex; gap:8px; align-items:center; margin-bottom:12px; }
.stake-btn {
  flex:1; padding:12px; border-radius:12px;
  background:rgba(255,255,255,.06); border:none;
  color:#fff; font-weight:800; font-size:13px;
}
.stake-btn.active { background:linear-gradient(135deg,#8a2be2,#ff0080); }
.spin-btn {
  width:100%; padding:18px; border:none; border-radius:18px;
  font-size:17px; font-weight:900; color:#000; cursor:pointer;
  letter-spacing:1px;
  background:linear-gradient(90deg,#00ff88,#00bfff,#8a2be2,#ff0080,#ff8c00,#ffd700,#00ff88);
  background-size:400% 100%;
  animation:rainbow 4s linear infinite;
  box-shadow:0 0 30px rgba(0,255,136,.4);
  transition:transform .1s;
}
.spin-btn:active { transform:scale(.97); }
.spin-btn:disabled { opacity:.5; animation-play-state:paused; }
@keyframes rainbow { 0% { background-position:0% 50%; } 100% { background-position:400% 50%; } }
.bottom-nav {
  position:fixed; bottom:0; left:0; right:0; z-index:20;
  background:rgba(10,10,14,.95); backdrop-filter:blur(20px);
  display:flex; padding:8px 6px 12px;
  border-top:1px solid rgba(255,255,255,.06);
}
.nav-item {
  flex:1; display:flex; flex-direction:column; align-items:center;
  gap:4px; padding:8px 4px;
  color:#666; font-size:10px; font-weight:700;
}
.nav-item.active { color:#2ecc71; }
.nav-item .ic { font-size:20px; }
.snackbar {
  position:fixed; bottom:80px; left:50%; transform:translateX(-50%) translateY(120px);
  background:rgba(30,30,38,.98); padding:12px 22px; border-radius:14px;
  font-size:13px; border:1px solid rgba(255,255,255,.12);
  transition:transform .3s; z-index:50; max-width:90%; text-align:center;
}
.snackbar.show { transform:translateX(-50%) translateY(0); }
.toast {
  position:fixed; top:80px; left:50%; transform:translateX(-50%) translateY(-20px);
  background:rgba(30,30,40,.98); padding:14px 22px; border-radius:14px;
  font-size:13px; z-index:300; opacity:0; transition:all .3s;
  border:1px solid rgba(255,255,255,.12); max-width:90%; text-align:center;
}
.toast.show { opacity:1; transform:translateX(-50%) translateY(0); }
#confetti { position:fixed; inset:0; pointer-events:none; z-index:150; display:none; }
#confetti.show { display:block; }
.confetti-piece {
  position:absolute; width:10px; height:10px;
  top:-20px; animation:confFall linear forwards;
}
@keyframes confFall {
  0% { transform:translateY(0) rotate(0deg); opacity:1; }
  100% { transform:translateY(105vh) rotate(720deg); opacity:0; }
}
</style>
</head>
<body>

<div id="snow"></div>
<div id="confetti"></div>

<div class="top-bar">
  <button class="menu-btn">
    <span></span><span></span><span></span>
  </button>
  <div class="lvl-pill">
    <span class="num">6</span>
    <div class="bar"><div></div></div>
  </div>
  <div class="clover-pill">
    <span>🍀</span><span>66</span>
  </div>
  <div class="balance-box">
    <div class="lbl">Баланс</div>
    <div class="val" id="balance">2 958 ₽</div>
  </div>
</div>

<div class="tabs">
  <button class="tab active">Номера</button>
  <button class="tab">Телефоны</button>
  <button class="tab gold">⭐ Магазин</button>
</div>

<div class="main">
  <div class="rarity-bar">
    <div>
      <div class="rarity-name" id="rarityName" style="color:#ffd700;">Легендарный</div>
      <div class="rarity-dots" id="rarityDots">
        <span class="on"></span><span class="on"></span><span class="on"></span><span class="on"></span><span class="on"></span><span></span>
      </div>
    </div>
    <div class="rarity-price" id="rarityPrice" style="color:#ffd700;">99 999 ₽</div>
  </div>

  <div class="number-card" id="numberCard">
    <div style="font-size:11px;color:#666;letter-spacing:2px;text-transform:uppercase;" id="numRarity">Крути номер</div>
    <div class="number-big" id="numBig">+7 (___) ___-__-__</div>
    <div class="number-region" id="numRegion">🇷🇺 Россия</div>
    <div class="beauty-list" id="beautyList"></div>
    <div class="actions">
      <button>📱 В телефон</button>
      <button>↗</button>
    </div>
  </div>

  <div class="stake-row">
    <button class="stake-btn active">×1 (бесплатно)</button>
    <button class="stake-btn">×5</button>
    <button class="stake-btn">×10</button>
  </div>

  <button class="spin-btn" id="spinBtn">КРУТИТЬ (бесплатно)</button>
</div>

<div class="bottom-nav">
  <div class="nav-item active"><div class="ic">🎰</div><div>Играть</div></div>
  <div class="nav-item"><div class="ic">📱</div><div>Телефоны</div></div>
  <div class="nav-item"><div class="ic">🛒</div><div>Магазин</div></div>
  <div class="nav-item"><div class="ic">👥</div><div>Друзья</div></div>
  <div class="nav-item"><div class="ic">⋯</div><div>Ещё</div></div>
</div>

<div class="snackbar" id="snackbar"></div>
<div class="toast" id="toast"></div>

<script>
// ================= SNOW =================
(function(){
  const c = document.getElementById('snow');
  for (let i=0;i<55;i++){
    const s = document.createElement('div');
    s.className = 'snowflake';
    const size = 1 + Math.random()*2.5;
    s.style.width = size+'px';
    s.style.height = size+'px';
    s.style.left = Math.random()*100+'%';
    s.style.animationDuration = (5 + Math.random()*8)+'s';
    s.style.animationDelay = (-Math.random()*10)+'s';
    s.style.opacity = 0.3 + Math.random()*0.5;
    c.appendChild(s);
  }
})();

// ================= SOUNDS =================
let audioCtx = null;
function getAudioCtx(){
  if (!audioCtx){
    try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e){}
  }
  return audioCtx;
}
function playTick(){
  const ctx = getAudioCtx(); if (!ctx) return;
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = 'square';
  osc.frequency.setValueAtTime(800, ctx.currentTime);
  osc.frequency.exponentialRampToValueAtTime(400, ctx.currentTime + 0.05);
  gain.gain.setValueAtTime(0.06, ctx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
  osc.connect(gain); gain.connect(ctx.destination);
  osc.start(); osc.stop(ctx.currentTime + 0.06);
}
function playAbsolute(){
  const ctx = getAudioCtx(); if (!ctx) return;
  const notes = [523, 659, 784, 1047, 1319, 1568];
  notes.forEach((freq, i)=>{
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(freq, ctx.currentTime + i*0.08);
    gain.gain.setValueAtTime(0.15, ctx.currentTime + i*0.08);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i*0.08 + 0.4);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(ctx.currentTime + i*0.08);
    osc.stop(ctx.currentTime + i*0.08 + 0.4);
  });
}

// ================= CONFETTI =================
function launchConfetti(){
  const c = document.getElementById('confetti');
  c.innerHTML = '';
  c.classList.add('show');
  const colors = ['#ff0080','#ffd700','#00ff88','#00bfff','#8a2be2','#ff3b5c'];
  for (let i=0;i<80;i++){
    const p = document.createElement('div');
    p.className = 'confetti-piece';
    p.style.left = Math.random()*100+'%';
    p.style.background = colors[Math.floor(Math.random()*colors.length)];
    p.style.animationDuration = (1.5 + Math.random()*1.5)+'s';
    p.style.animationDelay = (Math.random()*0.3)+'s';
    p.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
    c.appendChild(p);
  }
  setTimeout(()=>{ c.classList.remove('show'); }, 3500);
}

// ================= HELPERS =================
function showSnack(text){
  const s = document.getElementById('snackbar');
  s.textContent = text; s.classList.add('show');
  clearTimeout(s._t); s._t = setTimeout(()=>s.classList.remove('show'),2500);
}
function showToast(text, ms=2200){
  const t = document.getElementById('toast');
  t.textContent = text; t.classList.add('show');
  clearTimeout(t._t); t._t = setTimeout(()=>t.classList.remove('show'), ms);
}

// ================= SPIN =================
let spinning = false;
let spinCount = 0;

// КРАСИВЫЕ НОМЕРА (все legendary)
const LEGENDARY_NUMBERS = [
  { num: '+7 (999) 999-99-99', reasons: [{t:'9×9 подряд', m:200},{t:'топовое окончание 999', m:4}] },
  { num: '+7 (777) 777-77-77', reasons: [{t:'7×7 подряд', m:200},{t:'топовое окончание 777', m:4}] },
  { num: '+7 (888) 888-88-88', reasons: [{t:'8×8 подряд', m:200},{t:'топовое окончание 888', m:4}] },
  { num: '+7 (123) 456-78-90', reasons: [{t:'возрастающая последовательность', m:6},{t:'ровное начало 123', m:3}] },
  { num: '+7 (999) 123-45-67', reasons: [{t:'ровное начало 999', m:3},{t:'топовое окончание 999', m:4},{t:'последовательность', m:6}] },
  { num: '+7 (777) 123-45-67', reasons: [{t:'ровное начало 777', m:3},{t:'последовательность', m:6},{t:'топовое окончание 777', m:4}] },
];

function spin(){
  if (spinning) return;
  spinning = true;
  const btn = document.getElementById('spinBtn');
  btn.disabled = true;
  btn.textContent = 'КРУТИМ...';

  // Выбираем красивый номер
  const prize = LEGENDARY_NUMBERS[spinCount % LEGENDARY_NUMBERS.length];
  spinCount++;

  // Анимация прокрутки
  let ticks = 0;
  const el = document.getElementById('numBig');
  const tempNumbers = ['+7 (999) 123-45-67','+7 (777) 999-88-77','+7 (888) 555-44-33','+7 (999) 111-22-33'];
  const interval = setInterval(()=>{
    el.textContent = tempNumbers[Math.floor(Math.random()*tempNumbers.length)];
    playTick();
    ticks++;
    if (ticks >= 18){
      clearInterval(interval);
      finishSpin(prize);
    }
  }, 70);
}

function finishSpin(prize){
  document.getElementById('numBig').textContent = prize.num;
  document.getElementById('numRarity').textContent = 'ЛЕГЕНДАРНЫЙ';
  document.getElementById('numRarity').style.color = '#ffd700';
  document.getElementById('rarityName').textContent = 'Легендарный';
  document.getElementById('rarityName').style.color = '#ffd700';

  const dots = document.querySelectorAll('#rarityDots span');
  dots.forEach((d,i)=>{
    d.classList.toggle('on', i < 5);
    d.style.background = i<5 ? '#ffd700' : '';
  });

  const bl = document.getElementById('beautyList');
  bl.innerHTML = '';
  prize.reasons.forEach(r=>{
    const div = document.createElement('div');
    div.className = 'item';
    div.innerHTML = `${r.t} <span class="mult">×${r.m}</span>`;
    bl.appendChild(div);
  });

  const price = 99999;
  document.getElementById('rarityPrice').textContent = '99 999 ₽';

  playAbsolute();
  launchConfetti();

  const card = document.getElementById('numberCard');
  card.classList.add('shake');
  card.style.boxShadow = '0 0 60px #ffd70080';
  setTimeout(()=>{
    card.classList.remove('shake');
    card.style.boxShadow='';
  }, 2000);

  showSnack('+99 999 ₽  •  +25 опыта');

  spinning = false;
  btn.disabled = false;
  btn.textContent = 'КРУТИТЬ (бесплатно)';
}

document.getElementById('spinBtn').addEventListener('click', spin);
</script>
</body>
</html>
